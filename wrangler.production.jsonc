{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "grocer-eaze",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "no_bundle": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.js", "**/*.mjs"]
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "dist/client",
    "run_worker_first": false
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "grocer-eaze-production",
      "database_id": "c826022e-b924-4b1f-a18a-d891d76b61a6",
      "migrations_dir": "drizzle"
    }
  ],
  "secrets": {
    "required": [
      "AUTH_SECRET",
      "EMAIL_FROM",
      "INITIAL_ADMIN_EMAILS",
      "PEXELS_API_KEY",
      "RESEND_API_KEY",
      "SPOONACULAR_API_KEY",
      "STRIPE_MONTHLY_PRICE_ID",
      "STRIPE_SECRET_KEY",
      "STRIPE_WEBHOOK_SECRET",
      "STRIPE_YEARLY_PRICE_ID",
      "THEMEALDB_API_KEY"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
