{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "preview:cloudflare": "npm run build && wrangler dev --config wrangler.production.jsonc",
    "deploy:cloudflare": "npm run build && wrangler deploy --config wrangler.production.jsonc",
    "deploy:cloudflare:dry-run": "npm run build && wrangler deploy --config wrangler.production.jsonc --dry-run",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote --config wrangler.production.jsonc",
    "cf:types": "wrangler types --config wrangler.production.jsonc worker-configuration.d.ts",
    "test": "npm run build && npm run test:unit && npm run ux:audit",
    "test:unit": "node --test tests/rendered-html.test.mjs",
    "test:e2e": "playwright test",
    "ux:audit": "playwright test tests/accessibility-usability.spec.ts",
    "quality": "npm run lint && npm run test",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@cloudflare/vite-plugin": "1.50.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.2.0",
    "wrangler": "4.118.0"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "brace-expansion@<1.1.18": "1.1.18",
    "brace-expansion@>=3.0.0 <5.0.9": "5.0.9",
    "esbuild": "0.28.1",
    "fast-uri": "3.1.5",
    "js-yaml": "4.3.0",
    "postcss": "8.5.25",
    "sharp": "0.35.3",
    "undici@>=7.0.0 <7.29.0": "7.29.0"
  },
  "type": "module"
}
